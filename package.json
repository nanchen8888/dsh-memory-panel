{
  "name": "@local/dsh-memory-panel",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Left-sidebar memory browser for DeepSeek Harness: reads the markdown memory bank and renders it in a native panel.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
